# Copy to .env.local and fill in. Only EXPO_PUBLIC_* values reach the app bundle — never put secrets here.

# Phenko Mat web API (phenko-mat-web). On a physical device use your computer's LAN IP, not localhost,
# e.g. http://192.168.1.20:3000. Production: https://phenko-mat.vercel.app
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Optional: override the WebSocket URL returned by /api/realtime/ticket (useful on a device in dev,
# where the server's ws://localhost:3001/ws isn't reachable), e.g. ws://192.168.1.20:3001/ws
EXPO_PUBLIC_REALTIME_URL=""

# Firebase web config — same project as the web app (Project settings → Your apps → Web app).
EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID=""

# Google sign-in (optional; the button is hidden until these are set).
# Web client id from Firebase → Authentication → Google → Web SDK configuration.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# iOS client id, and its reversed form (used by the native config plugin at build time).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=""
