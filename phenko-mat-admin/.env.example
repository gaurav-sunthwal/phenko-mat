# Copy to .env.local. Uses the SAME database, Firebase project and R2 bucket as phenko-mat-web.

# Google accounts allowed into the panel, comma-separated. Must be verified Google/Firebase emails.
ADMIN_EMAILS="you@example.com"

# Neon Postgres (same as the web app)
DATABASE_URL=""

# Firebase web config (for the Google sign-in popup)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin (verifies admins, disables/deletes suspended accounts). Empty key = keyless ADC.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Cloudflare R2 (deletes photos of removed listings / deleted accounts)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
