# Copy to .env.local and fill in. Never commit real secrets.

# Neon Postgres (use the pooled "-pooler" host)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Firebase web config (public)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin. Leave CLIENT_EMAIL/PRIVATE_KEY empty to use keyless Application Default
# Credentials (`gcloud auth application-default login`, or the runtime service account on Cloud Run).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Legacy: only needed while old Firebase Storage photo URLs are still in the database.
FIREBASE_STORAGE_BUCKET=""

# Cloudflare R2 (photo uploads). Dashboard → R2 → Manage API tokens → "Object Read & Write"
# scoped to the bucket. Public URL = the bucket's r2.dev URL or custom domain, no trailing slash.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Location search (Android + web) via Google Places API (New). Server-side only — restrict the key to
# the Places API (New) and, in production, to your server's IPs. Empty = no suggestions, typing still works.
GOOGLE_MAPS_API_KEY=""

# Scheduled jobs send "Authorization: Bearer $CRON_SECRET" (daily photo cleanup: /api/cron/photo-cleanup).
# Generate: node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
CRON_SECRET=""

# Required in production: the public origin, i.e. https://phenko-mat.vercel.app. Used for CSRF checks and for SEO
# (canonical URLs, sitemap, robots.txt, share images, llms.txt). Unset, those all point at localhost.
APP_ORIGIN=""

# Realtime gateway (WebSocket chat)
# Generate: node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
REALTIME_SECRET=""
REALTIME_PORT=3001
REALTIME_INTERNAL_URL="http://localhost:3001"   # private URL the API uses to publish
REALTIME_ALLOWED_ORIGINS="http://localhost:3000" # comma-separated origins allowed to open sockets; production: https://phenko-mat.vercel.app
NEXT_PUBLIC_REALTIME_URL="ws://localhost:3001/ws" # public wss:// URL in production

# Optional: Microsoft Clarity project id (session replays and heatmaps). Unset = Clarity off.
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
